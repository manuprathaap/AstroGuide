# Copy this file to .env and replace placeholders with local development values.
# Never use these placeholders as production credentials.
APP_NAME=AstroGuide
APP_ENV=development
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=astroguide
DATABASE_USER=replace_me
DATABASE_PASSWORD=replace_me

JWT_SECRET_KEY=replace_with_a_random_secret
GEOAPIFY_API_KEY=replace_me

LLM_PROVIDER=groq
GROQ_API_KEY=replace_with_a_new_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Used by palm-image analysis; configure separately from the chat provider.
GEMINI_API_KEY=replace_me
GEMINI_VISION_MODEL=gemini-2.5-flash

# Configure SMTP only when sending real password-reset emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace_me
SMTP_PASSWORD=replace_me
SMTP_FROM=replace_me
SMTP_SSL=false
